# --- Supabase Configuration ---
# The URL of your Supabase project (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# The anon/public key of your Supabase project (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# The service role key of your Supabase project (KEEP THIS SECRET, SERVER-SIDE ONLY)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Security Configuration ---
# 32-byte hex key used to encrypt and decrypt chat messages
NEXT_PUBLIC_CHAT_ENCRYPTION_KEY=your_32_byte_hex_chat_encryption_key

# --- SMTP Configuration (e.g. Resend) ---
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM="Nomichi Travels <noreply@yourdomain.com>"

# --- Meta WhatsApp Business Configuration ---
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_TOKEN=your_whatsapp_api_token
